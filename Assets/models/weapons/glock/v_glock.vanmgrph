					m_sName = "Additive firing"
					m_vecPosition = [ -448.0, -512.0 ]
					m_nNodeID = 
					{
						m_id = 884693758
					}
					m_sNote = ""
					m_commentText = "\"Additive\" here refers to the fact that NOT that they are themselves summing between eachother (they can and did previously) but that they are added to whatever pose/state you are in, instead of direct playback (hijack)\n\nso if you are doing additive shit then the firing has to be delta anims subbed from itself, with Basepose being the single frame thing\n\nIF NOT then Base pose is just whatever input and SM Out is just straight output, no addition"
