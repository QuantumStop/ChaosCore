@namespace SDK

@using Core;
@using Sandbox;
@using Sandbox.UI;
@using System;
@using System.ComponentModel.DataAnnotations;

@attribute [StyleSheet( "Main_Menu.razor.scss" )]



<root style="width: 100%; height: 100%;">

	<content>

		<brand>
		    <img src="resource/ui/ct_logo.png" class="GameLogo"> 
		</brand>

		<buttons>

			@foreach (  MenuEntries _menuEntries in Enum.GetValues( typeof( MenuEntries ) ) )
			
//				if ( _menuEntries != null )
				{
					var isSelected = selectedEntry == _menuEntries ? "selected" : "";

					<button class=@($"{_menuEntries} {isSelected}") 
					 onmouseover="@(() =>  SetSelected(_menuEntries) )"
					 onmouseout="@(() =>   Sound.Play("sound/ui/ui_hover.sound"))" 
					 onclick="@(() => OnButtonClick(_menuEntries))">
						@GetDisplayName( _menuEntries )
					</button>
				}

		</buttons>

	</content>
	
</root>


@code 
{
	// TODO:
	// In the future lets switch this up for localization tokens
	// Like this: [Display(Name = "Menu.NewGame")]. 
	// This will just work, we just need em to begin with
	public enum MenuEntries
	{
		
		[Display( Name="New Game" )]
		NewGame,

		[Display( Name="Load Game" )]
		LoadGame,

		[Display( Name="Options" )]
		Options,

		[Display( Name="Quit" )]
		Quit
	}

	public MenuEntries _menuEntries { get; set; }

	private MenuEntries selectedEntry = MenuEntries.NewGame; // default
	[Property] public XGUI_MainMenu MenuLogic { get; set; }
	private XGUI_MainMenu menuLogic = new XGUI_MainMenu();
	
	private Dictionary<MenuEntries, Action> buttonActions => new()
	{

	// Look at this nice setup you can just expand upon! Woweee
	// This also checks if its not null, cant do a ?. cause its a method group
	[MenuEntries.NewGame]  = MenuLogic != null ? () => MenuLogic.StartNewGame() : () => {},
	[MenuEntries.LoadGame] = MenuLogic != null ? () => MenuLogic.LoadGame()     : () => {},
	[MenuEntries.Options]  = MenuLogic != null ? () => MenuLogic.OpenOptions()  : () => {},
	[MenuEntries.Quit]     = MenuLogic != null ? () => MenuLogic.QuitGame()     : () => {}

	};

	private void SetSelected(MenuEntries entry)
	{
		selectedEntry = entry;
	}

	private void OnButtonClick(MenuEntries entry)
	{
		if (buttonActions.TryGetValue(entry, out var action))
		action?.Invoke();
	}

	private string GetDisplayName(Enum enumValue)
	{
		var displayAttribute = enumValue
		.GetType()
		.GetField(enumValue.ToString())
		?.GetCustomAttributes(typeof(DisplayAttribute), false)
		.FirstOrDefault() as DisplayAttribute;
		
		return displayAttribute?.Name ?? enumValue.ToString();
	}

