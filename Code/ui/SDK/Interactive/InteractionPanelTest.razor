@using Sandbox;
@using Sandbox.UI;
@using System;
@using Core;

@inherits InteractPanel

@namespace SDK

<div class="windowroot">

	@if ( _showWindow == true )
	{
		<div class="window">
			
			@if ( b_HasButtons ) 
			{
				@if ( b_ProceduralPlacement )
				{

					@foreach ( var buttonId in ActiveButtons )
					{
						<button class="windowbutton" data-id="@buttonId.Key" > 
							@_buttonText
						</button>
					}

				}

				else
				{

					@foreach ( var buttonId in new[] { "button_1", "button_2", "button_3", "button_4", "button_5" } )
					{
						
						@if ( HasButton( buttonId ) )
						{
							<button class="windowbutton" data-id="@buttonId"  >
								@_buttonText
							</button>
						}

					}
				
				}
			}

		</div>
	}

</div>

@code {

	private bool _showWindow { get; set; }
	private bool HasButton( string buttonId ) => ActiveButtons.Any( x => x.Key == buttonId );
	private bool b_HasButtons => ActiveButtons.Count > 0;
	private bool b_ProceduralPlacement => false;

	// Reference to the parent InteractiveScreen
    [CascadingParameter] public InteractiveScreen ParentScreen { get; set; }

	private string _buttonText = "";

	protected override void OnStart()
	{
		_buttonText = "Enabled";
		_showWindow = true;
	}

	protected override void OnEnabled()
	{
		ParentScreen = this.GetComponentsInParent<InteractiveScreen>().FirstOrDefault();
	}

	protected override int BuildHash() => System.HashCode.Combine( _showWindow, _buttonText );

}
