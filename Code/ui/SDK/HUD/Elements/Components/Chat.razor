@namespace SDK

@using Sandbox
@using Sandbox.UI
@using Core
@using System

@inherits PanelComponent
@implements Component.INetworkListener

@attribute [StyleSheet]

<root>
    <canvas>

        <div class="chat-container">
            
			<!-- Messages panel -->
			<div class="chat-messages-box">

				<!-- HUD messages -->
				@if (!Open)
				{
					@GameManager.Instance.BuildHudChatMarkup(10)
				}


				<!-- Full chat messages -->
				@if (Open)
				{
					@GameManager.Instance.BuildFullChatMarkup()
				}

            </div>
						
			<!-- Input box -->
            <div class="chat-input-box">

				<ChatBox class="input" @ref="InputBox" 
				Placeholder="@(Open ? @ChatProximity : "")" 
				onsubmit="@ChatFinished" />
				
				@if (Open)
			    {
					<button class="input-button" onclick="@ChatFinished">
						SEND
					</button>
				}
			
			</div>
			
        </div>

    </canvas>
</root>

@code
{
	public static Chat Local { get; set; }
    private TextEntry InputBox { get; set; }
	private string ChatProximity { get; set; } = "Say to all";
	private bool IsChatOpen { get; set; }
	private bool Open => IsChatOpen;

	protected override void OnStart()
	{
		if (Local == null)
		    Local = this;
	}

	protected override int BuildHash()
	{
		return HashCode.Combine(Open);
	}

	protected override void OnUpdate()
	{
		if (InputBox is null) return;

		if (Input.Pressed("chat"))
		{
			IsChatOpen = true;
			InputBox.Focus();
		}

		if (IsChatOpen && Input.Keyboard.Pressed("enter"))
			ChatFinished();	
		
		StateHasChanged();

		
		SetClass("open", IsChatOpen);
	}

	void ChatFinished()
    {
        var text = InputBox.Text;
        InputBox.Text = "";

		if (string.IsNullOrWhiteSpace(text))
		{
			IsChatOpen = false;
			return;
		}

        GameManager.Instance.ProcessChatMessage(text);

		InputBox.Blur();
		IsChatOpen = false;
    }


    void Component.INetworkListener.OnConnected(Connection connection)
    {
        if (IsProxy) 
	        return;

        GameManager.Instance.AddSystemText( $"{connection.DisplayName} has joined the game", severity: MessageSeverity.Low );
    }

	void Component.INetworkListener.OnDisconnected(Connection connection)
	{
		if (IsProxy)
			return;

		GameManager.Instance.AddSystemText($"{connection.DisplayName} has left the server.", severity: MessageSeverity.Minor);
	}

    void Component.INetworkListener.OnBecameHost(Connection connection)
    {
        if (IsProxy) 
	        return;

        GameManager.Instance.AddSystemText($"{connection.DisplayName} has became the new host", severity: MessageSeverity.Low);
    }

}
