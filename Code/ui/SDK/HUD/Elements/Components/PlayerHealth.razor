@namespace SDK;
@using Core;
@using System
@using Sandbox.UI;


<root>

	<div class="hudHP @CurrentHealthClass" >

		<svg class="hudIcon @CurrentHealthClass" src="resource/ui/player/hud/health.svg" color=white />

		<div class="hudNumber">
			<span class="hudHealth hudUpper">@((int)Math.Round(fHealth))</span>
			<span class="hudHealth hudUnder">000</span>
			<div class="hudText">HEALTH</div>
		</div>

	</div>

</root>

@code
{
	public string CurrentHealthClass => GetHealthClass();
	public float fHealth             => BasePlayer.Local.Health;

	public string GetHealthClass()
	{
		if (fHealth >= 25)
			return "HP";
		else
			return "HPLow";
	}

	protected override int BuildHash() => System.HashCode.Combine( fHealth, CurrentHealthClass  );
}

