//	ChaosHUD.razor
//	──────────────────────────────────────────────────────────────────────────────
//	This file serves as the main Razor component for the HUD system.
//	It acts as the central integration point for all HUD-related elements and logic, ensuring that
//	various UI components are composed and managed cohesively.

//	- Composes and arranges all HUD subcomponents (PlayerStatus, WeaponStatus, etc.)
//	- Provides a single point of maintenance for HUD layout and logic 
*@

@namespace SDK

@using System;
@using Sandbox.UI;
@using Core;

@inherits PanelComponent

@if ( b_HideUI ) return;

<root>

	<canvas>

		<div class="Left">

        @if ( !b_SuitRequired || !b_NoSuit )
		{
			<PlayerStatus/>
		}
			
        </div>


		<WeaponSelection/>
	    @* <DamageIndicator/> *@
		

		<div class="Right">

			@if ( b_WeaponEquipped )
			{
				<WeaponStatus/>
			}

        </div>

    </canvas>

</root>

@code
{
    private bool b_HideUI => BasePlayer.Local.IsHUDElementHidden( BasePlayer.HIDEHUD_FLAGS.HIDEHUD_PLAYERDEAD );
	private bool b_NoSuit => BasePlayer.Local.IsHUDElementHidden( BasePlayer.HIDEHUD_FLAGS.HIDEHUD_NEEDSUIT );
	private bool b_SuitRequired
	{
		get
		{
			string className = this.GetType().Name;
			HudRazorClass entry = BasePlayer.Local.PlayerCfg.HudEntries
			.FirstOrDefault(x =>
			System.IO.Path.GetFileNameWithoutExtension(x.RazorPath) == className);

			return entry?.RequireSuitToDraw ?? false;
		}
	}

    public static bool b_ShowHud        => BasePlayer.ShowHud;
	public static bool b_WeaponEquipped => BasePlayer.Local.CurrentWeapon.IsValid();
	[Property] public string aspectClass { get; set; }

	private float _lastAspect;
	private string _lastAspectClass;

	protected override void OnFixedUpdate()
	{
		if ( Screen.Aspect != _lastAspect )
		{
			_lastAspect = Screen.Aspect;

			// Update new class
			string newClass = Screen.Aspect < 1.4f ? "aspect-43" :
			Screen.Aspect > 2.3f ? "aspect-ultrawide" : "aspect-169";

			// Only change classes if the category changed
			if ( newClass != _lastAspectClass )
			{
				if (!string.IsNullOrEmpty(_lastAspectClass))
					SetClass(_lastAspectClass, false);

				SetClass(newClass, true);
				_lastAspectClass = newClass;

				Log.Info($"[ChaosHUD] Aspect Class changed to: {newClass}");
			}
		}
	}



	protected override int BuildHash() => System.HashCode.Combine( b_WeaponEquipped, b_NoSuit, b_ShowHud, b_HideUI );
}
