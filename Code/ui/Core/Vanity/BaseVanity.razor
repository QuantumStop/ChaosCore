@inherits VanityUI
@namespace Core
@using System

<root>

	@if (ActiveChannels.Count > 0)
	{
		@foreach (var ch in ActiveChannels.Values)
		{
			var isFade = ch.Effect == "fade";

			<div class="@($"{ch.Id} {ch.Effect} ")" style="@GetRootStyle(ch)">

				@if (ch.Effect == "fade")
				{
					var animationDirection = ch.FadeFrom
					? "screen-fade-out"
					: "screen-fade-in";

					// Determine the animation name based on whether it's permanent or not
					var animationName = ch.IsDrawPermanent
					? "screen-fade-in"     // Permanent In
					: animationDirection;  // Singular one (or blink)

					var totalDuration = ch.IsDrawPermanent
					? ch.FadeInTime // Only fade-in if permanent
					: ch.FadeInTime + ch.HoldTime + ch.FadeOutTime; // Fade-in, hold, and fade-out for non-permanent

					// Make sure the fade-in duration doesn't exceed total duration
					var fadeInDuration = Math.Min(ch.FadeInTime, totalDuration);

					// Apply the animation to the element with properly formatted inline styles
					<div class="vanity-fade" style="
			            background-color: @($"{ch.BackgroundColor.ToCssRgba()}");
			            animation: @($"{animationName} {totalDuration:0.00}s ease-in-out forwards");
			        "></div>
				}
				else
				{
					<div class="vanity-text" style="@GetTextBlockStyle(ch)">
						@{
							var lines = GetTextLines(ch);
							var totalCharCount = lines.Sum(line => string.IsNullOrEmpty(line) ? 0 : line.Length);
							int globalCharIndex = 0;

							for (int lineIndex = 0; lineIndex < lines.Length; lineIndex++)
							{
								var line = lines[lineIndex];

								if (string.IsNullOrEmpty(line))
									continue;

								<div class="vanity-line">
									<span class="vanity-line-text">
										@if (ch.Effect == "scanout")
										{
											foreach (var c in line)
											{
												<span class="vanity-char char-@globalCharIndex" style="@GetScanCharStyle(ch, globalCharIndex, totalCharCount)">@c</span>
												globalCharIndex++;
											}
										}
										else
										{
											@line
										}
									</span>
								</div>
							}
						}
					</div>
				}
			</div>
		}
	}

</root>
