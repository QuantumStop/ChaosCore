@inherits PanelComponent
@namespace ChaosCore;
@using Core;

<root>
	<div>
		@if (_bShowExpo)
		{
			<div class="block">
				<div style="color: rgb(255, 68, 165)">ISO: @_ISO</div>
				<div style="color: rgb(255, 68, 165)">Shutter: 1/@_Shutter</div>
				<div style="color: rgb(194, 129, 184)">Aperture: @_Aperture.ToString()f</div>
				<div style="color: rgb(67, 130, 255)">EV: @_EV.ToString()</div>
				<div style="color: rgb(67, 130, 255)">Bias: @_Exposure</div>
			</div>
		}
	</div>
</root>

@code
{
	private bool _bShowExpo => BasePlayer.ShowExpo;

	private string _ISO => CameraExposure.Instance.ISO.ToString();
	private string _Shutter => CameraExposure.Instance.Shutter.ToString();
	private string _Aperture => CameraExposure.Instance.Aperture.ToString();
	private string _EV => CameraExposure.Instance.RealEV.ToString("0.0");
	private string _Exposure => CameraExposure.Instance.ResultExposure.ToString();

	protected override int BuildHash()
	{
		if (CameraExposure.Instance == null)
			return 0;

		return System.HashCode.Combine(
		_bShowExpo,
		_ISO,
		_Shutter,
		_Aperture,
		_EV,
		_Exposure
		);
	}
}
