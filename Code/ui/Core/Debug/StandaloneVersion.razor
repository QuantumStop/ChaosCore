@namespace Core

@inherits PanelComponent
@using Sandbox.Menu
@using Sandbox.UI;
@using System;

<root>

	@if ( bIsStandalone )
	{
		<div class=DevDate>

		@{
			var projectName = Sandbox.Game.Ident.Replace("local.", "");
			if (!string.IsNullOrEmpty(projectName))
				projectName = char.ToUpper(projectName[0]) + projectName.Substring(1);
		}

		@projectName Development Build: @sBuildVersion
		<div class=DevVersion>Build: @iBuildNumber</div>
		
		</div>
	}
	
</root>

@code
{

	public bool bIsStandalone = false;
	public string sBuildVersion => Standalone.BuildDate.ToString();
	public static int iBuildNumber { get; set; }

	protected override void OnEnabled()
	{
		CalcBuildNumber();

		if (Application.IsStandalone)
		bIsStandalone = true;
	}

	private void CalcBuildNumber()
	{
		int d = Standalone.BuildDate.Day; int m = Standalone.BuildDate.Month; int y = Standalone.BuildDate.Year;
		//int d = DateTime.Now.Day; int m = DateTime.Now.Month; int y = DateTime.Now.Year;
		int[] days = { 0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 303, 334, 365 }; // amount of days in a year in every month
		m -= 1; // TimeDate struct is 1-12, array is 0-11, so offset the number
		iBuildNumber = 365 * (y - 2025) - 31 + days[m] + d; // original method had 1999, we are not in 1999
	}

	protected override int BuildHash() => System.HashCode.Combine(
	sBuildVersion,
	bIsStandalone
	);
}
