@using Sandbox;
@using Sandbox.UI;
@using XGUI;
@attribute [StyleSheet("/XGUI/DefaultStyles/OliveGreen.scss")]
@inherits Window

<root title="Hello" hasminimise="true" hasmaximise="true">

	@* You can make labels like this *@
	Hello, I am a window!

	@* Or this! *@
	<label>Wowee!</label>

	@* Self explanitory! *@
	<button>okay</button>

	@* This is a tab control! *@
	<tabcontrol>
		@* You define a tab and the contents of its page like this*@
		<tab tabName="general" slot="tab" tabtext="General">
			<div style="width:300px;height:200px;">

				@* This is a slider! *@
				<slider min=1 max=10 mintext="1.00" maxtext="10.0" step=1></slider>

				@* This is a slider with step indicators! *@
				<sliderscale min=1 max=10 mintext="1.00" maxtext="10.0" step=1></sliderscale>

				@* This is a slider with step indicators and a text entry next to it! *@
				<sliderscaleentry min=1 max=10 mintext="1.00" maxtext="10.0" step=1></sliderscaleentry>


				@* Self explanitory! *@
				<check>checkbox</check>
				<button>HI!!!</button>
				<textentry></textentry>

				@* Not implemented yet :( *@
				<radiobuttons>

				</radiobuttons>


				@* This is a dropdown! *@
				<selector default="Widescreen" style="margin-top:2px;">
					<option value="normal">Normal</option>
					<option value="widescreen">Widescreen</option>
				</selector>

			</div>
		</tab>
		<tab tabName="video" slot="tab" tabtext="Video">
			<div style="width:300px;height:200px;">
			</div>
		</tab>
		<tab tabName="audio" slot="tab" tabtext="Audio">
			<div style="width:300px;height:200px;">
			</div>
		</tab>
	</tabcontrol>

	@* You can add a resizing handlebar in the bottom right with the resizer element*@
	<resizer></resizer>
</root>
